@startuml component
' Diagramme de composants — Architecture logicielle
!theme plain
skinparam componentStyle rectangle
skinparam component {
  BorderColor #0284C7
  BackgroundColor #EFF6FF
}
skinparam database {
  BorderColor #0F766E
  BackgroundColor #F0FDFA
}

package "Interface utilisateur" {
  [Streamlit UI\nstreamlit_app.py + pages/] as UI
  [RBAC & Session\nsession.py] as RBAC
  [Thème & styles\ncss.py] as CSS
}

package "Pipeline RAG" {
  [Ingestion\nparser · chunker · watcher] as ING
  [Indexation\nvector_store · LocalEmbeddingFunction] as IDX
  [Retrieval\nretriever · BM25 · RRF · rerank] as RET
  [Generation\nllm.py (Ollama / Mistral)] as GEN
  [Cœur RAG\ncore/rag_engine.py (RAGEngine)] as CORE
  [Évaluation\neval_pipeline (Ragas)] as EVAL
  [Observabilité\nQueryLogger] as OBS
}

package "Persistance" {
  database "ChromaDB\ncollection : rag_documents\nHNSW · cosine" as CHROMA
  database "SQLite : rag.db\nusers · doc_versions · chat_history" as SQL
  database "SQLite : query_logs.db\njournal des requêtes" as LOG
  file "data/evaluation_report.csv\nrapport RAGAS" as CSV
}

UI ..> RBAC : <<uses>>
UI ..> CSS : <<uses>>
UI --> ING : indexation de fichiers
UI --> RET : questions du chat
UI --> EVAL : lancement évaluation
UI --> OBS : journalisation requêtes
UI --> CORE : orchestrateur RAG (init_rag_engine)
ING --> IDX : TextChunk[]
IDX --> CHROMA : vecteurs + métadonnées
RET --> CHROMA : requête cosine (where)
RET ..> IDX : embeddings requête
RET --> GEN : contexte formaté + sources (citations)
CORE --> RET : retrieve() / answer()
CORE --> IDX : ingest_document() / ingest_sql()
CORE --> GEN : generate() (LLM local)
EVAL --> CORE : RAGEngine().answer() (moteur partagé)
EVAL --> GEN : juge Ragas (Mistral)
EVAL --> CSV : export_results() (rapport)
UI --> SQL : comptes / historique
CORE --> SQL : versions (doc_versions, global C1/Mo4)
OBS --> LOG : journal
@enduml
