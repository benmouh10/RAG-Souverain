@startuml class
' Diagramme de classes — RAG Souverain
!theme plain
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #0284C7
  BackgroundColor #F8FAFC
}
hide empty members

' ---------------- INGESTION ----------------
package "Ingestion (app/ingestion)" {

  class DocumentParser {
    + parse_file(path) : ParsedDocument
    + parse_directory(dir) : list<ParsedDocument>
    + iter_pages(directory)
    --private--
    _parse_pdf(path)
    _extract_pdf_native(page)
    _extract_pdf_page_ocr(page)
    _parse_text_file(path)
  }

  class ParsedDocument {
    + source_path : Path
    + pages : list<ParsedPage>
    + source_file : str
    + full_text : str
    + page_count : int
  }

  class ParsedPage {
    + content : str
    + source_file : str
    + page_number : int | None
    + extraction_method : ExtractionMethod
    + file_extension : str
    + metadata : dict
    + is_empty : bool
  }

  enum ExtractionMethod {
    PDF_NATIVE
    PDF_OCR
    TEXT
    SQL
  }

  class SQLParser {
    + parse_all_tables() : list<SQLRecord>
    + parse_table(name)
    + to_parsed_documents()
    + close()
  }

  class SQLRecord {
    + table_name : str
    + record_id
    + content : str
    + to_parsed_page() : ParsedPage
  }

  class AdaptiveChunker {
    + chunk_size : int = 512
    + chunk_overlap : int = 100
    + chunk_documents(docs) : list<TextChunk>
    + chunk_document(doc) : list<TextChunk>
    --private--
    _chunk_by_sections(text)
    _chunk_by_sliding_window(page)
    _chunk_by_table(page)
    _chunk_sql(page)
    _is_structured(text)
  }

  class TextChunk {
    + content : str
    + source_file : str
    + page_number : int | None
    + chunk_index : int
    + strategy : ChunkStrategy
    + version : int
    + to_metadata() : dict
  }

  enum ChunkStrategy {
    SECTION
    SLIDING_WINDOW
    TABLE
    SQL
  }

  class WatcherEventHandler {
    + on_created(event)
    + on_modified(event)
    - _schedule_ingest()
  }
}

' ---------------- INDEXATION ----------------
package "Indexation (app/indexing)" {

  class LocalEmbeddingFunction {
    - _model : SentenceTransformer
    + __call__(texts) : list<list<float>>
    + embed_query(q) : list<float>
    + name() : str
  }

  class ChromaVectorStore {
    + persist_directory : Path
    + collection_name : str = "rag_documents"
    + initialize_collection(reset)
    + add_chunks(chunks) : int
    + search(query, top_k, where) : list<SearchResult>
    + search_latest(query, max_version)
    + get_latest_version(filename) : int
    + delete_by_source(filename) : int
    + list_sources()
    + clear()
    + count() : int
  }

  class SearchResult {
    + id : str
    + content : str
    + score : float
    + metadata : dict
  }
}

' ---------------- RETRIEVAL ----------------
package "Retrieval (app/retrieval)" {

  class Retriever {
    + vector_store : ChromaVectorStore
    - _llm
    + retrieve(query, top_k, min_score, where)
    + format_context(results) : str
    --private--
    _bm25_search(query)
    _rrf_merge(vector, bm25)
  }
}

' ---------------- GENERATION ----------------
package "Generation (app/generation)" {

  class OllamaLLM {
    + model_name : str = "mistral"
    + base_url : str
    + temperature : float = 0.1
    + last_health : bool | None
    + generate(query, context, history) : str
    + generate_stream(query, context, history)
    + build_prompt(query, context, history) : str
    + generate_hypothetical_answer(question) : str
    + health_check(timeout) : bool   (M2)
    + circuit_open : bool
  }
}

' ---------------- CŒUR & ORCHESTRATION ----------------
package "Cœur (app/core)" {

  class RAGEngine {
    + top_k : int = 6
    + min_score : float = 0.0
    + model_name : str
    + vector_store : ChromaVectorStore
    + retriever : Retriever
    + llm : OllamaLLM | None
    + ollama_available : bool
    + ingest_document(path, filename, data) : (int, int)
    + ingest_sql(db_path) : int
    + answer(question) : (str, list)
    - _check_ollama() : bool
  }
}

' ---------------- ÉVALUATION ----------------
package "Évaluation (app/evaluation)" {

  class run_evaluation {
    + run_evaluation(progress_callback, timeout_seconds) : list<EvalResult>
    + export_results(results, path)
  }

  class EvalResult {
    + question : str
    + reference : str
    + response : str
    + contexts : list
    + latency_ms : float
    + faithfulness : float
    + relevance : float
    + metrics_available() : bool
  }

  run_evaluation ..> EvalResult : "produit"
}

' ---------------- PERSISTANCE & UI ----------------
package "Persistance & UI" {

  class Database {
    + create_user(username, password, role)
    + authenticate(username, password) : User | None
    + change_password(user_id, password)
    + delete_user(user_id)
    + record_ingestion(filename, hash, count) : DocVersion
    + get_latest_version(filename) : DocVersion | None
    + get_file_hash(filename) : str | None
    + list_documents() : list<DocVersion>
    + get_total_chunks() : int
    + save_chat_message(user_id, role, content, sources)
    + get_chat_history(user_id, conversation_id, limit)
  }

  class User {
    + user_id : int
    + username : str
    + role : str
    + created_at : float
  }

  class DocVersion {
    + doc_id : int
    + filename : str
    + file_hash : str
    + version : int
    + chunk_count : int
    + indexed_at : float
  }

  class QueryLogger {
    + log(question, scores, chunks, latencies, model, sources)
    + get_recent(limit)
    + get_stats(limit)
  }
}

' ---------------- RELATIONS ----------------
DocumentParser --> ParsedDocument : "produit"
ParsedDocument o-- "1..*" ParsedPage
ParsedPage --> ExtractionMethod
SQLParser --> SQLRecord
SQLRecord ..> ParsedPage : to_parsed_page()
ParsedDocument --> AdaptiveChunker : "découpe"
AdaptiveChunker --> TextChunk : "produit"
TextChunk --> ChunkStrategy
TextChunk ..> ChromaVectorStore : "indexé dans"
ChromaVectorStore o-- LocalEmbeddingFunction
ChromaVectorStore --> SearchResult : "retourne"
Retriever --> ChromaVectorStore
Retriever o-- OllamaLLM : "HyDE / rerank (option)"   (Mo3)
RAGEngine o-- ChromaVectorStore
RAGEngine o-- Retriever
RAGEngine o-- OllamaLLM
RAGEngine --> Database : "versionnage global (C1/Mo4)"
Database --> User
Database --> DocVersion
@enduml
