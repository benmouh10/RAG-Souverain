@startuml sequence_performance
' Diagramme de séquence — Page Performance (lecture SQLite, bridge C3)
!theme plain
actor Utilisateur
participant "pages/performance.py" as Perf
participant "QueryLogger\n(app/observability.py)" as QL
participant "query_logs\n(SQLite)" as SQL

Utilisateur -> Perf: navigue vers "Performance"
Perf -> Perf: require_admin() (M1)
alt utilisateur non admin
  Perf --> Utilisateur: accès refusé (st.error)
else admin
  Perf -> QL: get_stats(limit=50)
  QL -> SQL: SELECT ... FROM query_logs ORDER BY timestamp DESC LIMIT 50
  SQL --> QL: lignes brutes
  QL --> Perf: stats agrégées (avg_top1, avg_mean, latence, top_sources)
  Perf -> QL: get_recent(limit=50)
  QL -> SQL: SELECT ... (relecture chronologique)
  SQL --> QL: lignes brutes
  QL --> Perf: entrées récentes (sources JSON désérialisées)
  Perf --> Utilisateur: KPIs + courbes (Top-1, latence) depuis SQLite
  note right of Perf
    C3 : la page Performance recharge les données depuis SQLite
    à chaque chargement — elle ne dépend PAS de session_state.
  end note
end
@enduml
